{
  "name": "playwright-ecommerce-checkout",
  "version": "1.0.0",
  "description": "End-to-end tests for a small demo web shop: search, cart, checkout validation and API failure handling.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app/server.js",
    "test": "playwright test",
    "test:chromium": "playwright test --project=api --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:api-errors": "playwright test --grep @api-errors",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "demo:record": "playwright test --config=playwright.demo.config.ts && bash scripts/make-demo-media.sh",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
